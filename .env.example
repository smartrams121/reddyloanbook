# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/daily_finance?schema=public"

# Auth
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"
SESSION_EXPIRY_HOURS=24

# Environment
NODE_ENV="development"

# Upload directory (for customer photos, documents)
UPLOAD_DIR="./uploads"

# Resend Email Service (https://resend.com — free tier, no credit card)
# If left empty, emails are skipped silently (fine for local dev)
RESEND_API_KEY=

# App URL used in email links
# Change to https://reddyloanbook.duckdns.org before deploying
NEXT_PUBLIC_APP_URL=http://localhost:3002
