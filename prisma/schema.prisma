generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── ENUMS (SQLite doesn't support enums, so we use String with validation) ───
// Role: PLATFORM_ADMIN, OWNER, BUSINESS_ADMIN, AGENT
// CollectionType: DAILY, WEEKLY, MONTHLY
// InterestModel: ADDON, UPFRONT
// CustomerStatus: ACTIVE, CLOSED
// LoanStatus: ACTIVE, OVERDUE, COMPLETED (stored as default; actual status derived from loan data)
// DayOfWeek: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  fullName           String
  organizationName   String?
  phone              String?
  email              String?
  role               String   // Role enum
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  preferredLanguage  String   @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions              Session[]
  ownedBusinesses       Business[]
  businessAssignments   UserBusinessAssignment[]
  villageAssignments    UserVillageAssignment[]
  collectedPayments     Payment[]      @relation("CollectedBy")
  assignedLoans         Loan[]         @relation("AssignedAgent")
  cashHandoversGiven    CashHandover[] @relation("HandoverAgent")
  cashHandoversReceived CashHandover[] @relation("HandoverReceiver")
  expensesPaid          Expense[]      @relation("ExpensePaidBy")
  auditLogs             AuditLog[]
  supportAccessGranted  SupportAccess[] @relation("SupportGrantedBy")
  supportAccessReceived SupportAccess[] @relation("SupportGrantedTo")
  passwordResetRequests PasswordResetRequest[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token            String   @unique
  activeBusinessId String?
  expiresAt        DateTime
  lastActivityAt   DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model SupportAccess {
  id        String    @id @default(cuid())
  ownerId   String
  adminId   String
  owner     User      @relation("SupportGrantedBy", fields: [ownerId], references: [id])
  admin     User      @relation("SupportGrantedTo", fields: [adminId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([adminId])
}

// ─── BUSINESS ─────────────────────────────────────────────────────────────────

model Business {
  id                   String  @id @default(cuid())
  name                 String
  city                 String
  address              String?
  phone                String?
  logoPath             String?
  receiptPrefix        String?

  ownerId              String
  owner                User    @relation(fields: [ownerId], references: [id])

  collectionType       String  @default("DAILY")
  defaultCollectionDay String?
  interestModel        String  @default("ADDON")
  collectionDays       String  @default("MON,TUE,WED,THU,FRI,SAT,SUN")

  gracePeriodDaily     Int     @default(30)
  gracePeriodWeekly    Int     @default(4)
  gracePeriodMonthly   Int     @default(1)
  defaulterPeriodDays  Int     @default(365)

  repaymentMultiplierDailyWeekly Float @default(1.20)
  repaymentMultiplierMonthly     Float @default(1.40)

  ratingGoodMaxPct     Int     @default(50)
  ratingAverageMaxPct  Int     @default(100)

  maxLoanByRating      String? // JSON string: {"4":5000000,"3":3000000,...} in paise

  whatsappTemplate     String  @default("{{businessName}}: Received ₹{{amount}} on {{date}}. Outstanding: ₹{{outstanding}}. Thank you!")
  autoLogoutMinutes    Int     @default(30)

  receiptSeq           Int     @default(0)
  loanSeq              Int     @default(0)
  customerSeq          Int     @default(0)

  // Configurable ID formats
  customerIdFormat     String  @default("NUMERIC")
  customerIdPrefix     String  @default("")
  customerIdPadding    Int     @default(4)
  customerIdStart      Int     @default(1)
  customerIdMax        Int     @default(100000)

  loanIdFormat         String  @default("NUMERIC")
  loanIdPrefix         String  @default("")
  loanIdPadding        Int     @default(5)
  loanIdStart          Int     @default(1)
  loanIdMax            Int     @default(100000)

  receiptIdFormat      String  @default("NUMERIC")
  receiptIdPrefix      String  @default("")
  receiptIdPadding     Int     @default(5)
  receiptIdStart       Int     @default(1)
  receiptIdMax         Int     @default(100000)

  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  villages          Village[]
  customers         Customer[]
  loans             Loan[]
  payments          Payment[]
  holidays          Holiday[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  cashBookEntries   CashBookEntry[]
  cashHandovers     CashHandover[]
  auditLogs         AuditLog[]
  userAssignments   UserBusinessAssignment[]
  documents         Document[]

  @@unique([ownerId, name])
}

model UserBusinessAssignment {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model UserVillageAssignment {
  id        String   @id @default(cuid())
  userId    String
  villageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  village   Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, villageId])
}

// ─── VILLAGE ──────────────────────────────────────────────────────────────────

model Village {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customers        Customer[]
  agentAssignments UserVillageAssignment[]

  @@unique([businessId, name])
}

// ─── CUSTOMER ─────────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  customerId     String
  fullName       String
  age            Int?
  phone          String
  altPhone       String?
  address        String?
  aadhaarHash    String?
  aadhaarLast4   String?
  photoPath      String?
  jobType        String?
  guarantorName  String?
  guarantorPhone String?
  notes          String?
  latitude       Float?
  longitude      Float?
  status         String   @default("ACTIVE")

  villageId  String
  village    Village  @relation(fields: [villageId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  loans     Loan[]
  documents Document[]

  @@unique([businessId, customerId])
  @@index([businessId, phone])
  @@index([businessId, fullName])
  @@index([businessId, status])
  @@index([businessId, villageId])
  @@index([businessId, createdAt])
}

// ─── LOAN ─────────────────────────────────────────────────────────────────────

model Loan {
  id                    String   @id @default(cuid())
  loanNumber            String

  customerId            String
  customer              Customer @relation(fields: [customerId], references: [id])
  businessId            String
  business              Business @relation(fields: [businessId], references: [id])

  loanAmount            Int
  interestAmount        Int
  totalRepayable        Int
  amountGiven           Int
  interestModel         String  @default("ADDON")

  collectionType        String
  collectionDay         String?
  installmentAmount     Int
  numberOfInstallments  Int
  lastInstallmentAmount Int

  startDate             String // YYYY-MM-DD (SQLite date)
  expectedEndDate       String // YYYY-MM-DD

  agentId               String?
  agent                 User?    @relation("AssignedAgent", fields: [agentId], references: [id])

  status                String   @default("ACTIVE")
  statusOverride        String?
  statusOverrideDate    String?

  renewedFromLoanId     String?  @unique
  renewedFromLoan       Loan?    @relation("LoanRenewal", fields: [renewedFromLoanId], references: [id])
  renewedToLoan         Loan?    @relation("LoanRenewal")

  pausedAt              String?
  settlementAmount      Int?
  settlementReason      String?
  writeOffReason        String?
  closedAt              String?

  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  schedule LoanScheduleEntry[]
  payments Payment[]
  documents Document[]

  @@unique([businessId, loanNumber])
  @@index([businessId, status])
  @@index([businessId, startDate])
  @@index([customerId])
  @@index([agentId, businessId])
}

model LoanScheduleEntry {
  id                String @id @default(cuid())
  loanId            String
  loan              Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           String // YYYY-MM-DD
  amount            Int

  @@unique([loanId, dueDate])
  @@index([loanId, installmentNumber])
}

// ─── PAYMENT ──────────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(cuid())
  receiptNumber String

  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  amount      Int
  paymentDate String // YYYY-MM-DD

  collectorId String
  collector   User   @relation("CollectedBy", fields: [collectorId], references: [id])

  note      String?
  latitude  Float?
  longitude Float?
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, receiptNumber])
  @@index([businessId, paymentDate])
  @@index([loanId, paymentDate])
  @@index([loanId, isDeleted])
  @@index([collectorId, paymentDate])
}

// ─── HOLIDAY ──────────────────────────────────────────────────────────────────

model Holiday {
  id         String   @id @default(cuid())
  date       String // YYYY-MM-DD
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, date])
}

// ─── EXPENSE ──────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  isActive   Boolean  @default(true)

  expenses Expense[]

  @@unique([businessId, name])
}

model Expense {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id])
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount     Int
  date       String // YYYY-MM-DD
  paidById   String
  paidBy     User            @relation("ExpensePaidBy", fields: [paidById], references: [id])
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([businessId, date])
}

// ─── CASH BOOK ────────────────────────────────────────────────────────────────

model CashBookEntry {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id])
  date                String // YYYY-MM-DD
  openingCash         Int
  loansDisbursed      Int
  collectionsReceived Int
  handoversReceived   Int
  expensesTotal       Int
  closingCash         Int
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([businessId, date])
}

model CashHandover {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  agentId      String
  agent        User     @relation("HandoverAgent", fields: [agentId], references: [id])
  receivedById String
  receivedBy   User     @relation("HandoverReceiver", fields: [receivedById], references: [id])
  date         String // YYYY-MM-DD
  amount       Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, date])
  @@index([agentId, date])
}

// ─── DOCUMENT ─────────────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  loanId       String?
  loan         Loan?     @relation(fields: [loanId], references: [id])
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  type         String
  filePath     String
  originalName String
  mimeType     String
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([loanId])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  oldValues  String? // JSON string
  newValues  String? // JSON string
  reason     String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

// ─── PASSWORD RESET REQUESTS ────────────────────────────────────────────────
// PasswordResetStatus: PENDING, COMPLETED, CANCELLED

model PasswordResetRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING")
  note       String?
  resolvedBy String?
  resolvedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── PLATFORM SETTINGS ───────────────────────────────────────────────────────

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─── REGISTRATION REQUESTS ───────────────────────────────────────────────────
// RegistrationStatus: PENDING, APPROVED, REJECTED

model RegistrationRequest {
  id                   String    @id @default(cuid())
  fullName             String
  phone                String
  email                String?
  username             String    @unique
  passwordHash         String
  businessName         String
  city                 String
  villages             String
  collectionType       String    @default("DAILY")
  defaultCollectionDay String?
  status               String    @default("PENDING")
  rejectionReason      String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([phone])
}

// ─── EMAIL LOG ──────────────────────────────────────────────────────────────
