# ─── Database ─────────────────────────────────────────────────────────────────
# Docker Compose: app connects to 'postgres' (service name)
# Standalone: app connects to 'localhost'
POSTGRES_USER=financeapp
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=financeapp_db
DATABASE_URL="postgresql://financeapp:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/financeapp_db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SESSION_EXPIRY_HOURS=24

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
UPLOAD_DIR=/app/uploads
